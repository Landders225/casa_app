# =============================================================================
#  CASA — Configuration Laravel, MODE TEST LOCAL EN HTTP DIRECT (Lot 11).
#
#  Copier en backend/.env.test-local (GITIGNORÉ) :
#    cp backend/.env.test-local.example backend/.env.test-local
#
#  Injecté dans le conteneur `backend` par docker-compose.test-local.yml.
#
#  ⚠️⚠️  MODE TEST — À NE PAS UTILISER EN PRODUCTION RÉELLE  ⚠️⚠️
#  Différences avec backend/.env.production.example :
#    APP_URL                 http://<IP>:8090   (pas de https, avec le port)
#    SESSION_SECURE_COOKIE   false              (le login doit marcher en HTTP)
#    SESSION_DOMAIN          <IP du serveur>    (host exact ; pas de domaine)
#    SANCTUM_STATEFUL_DOMAINS <IP>:8090         (avec le port 8090 !)
#  Pour passer en prod réelle (§ 14) : repasser SESSION_SECURE_COOKIE=true,
#  APP_URL=https://<domaine>, SESSION_DOMAIN=<domaine>, SANCTUM_...=<domaine>.
# =============================================================================

APP_NAME=CASA
APP_ENV=production
# false : même posture qu'en prod (pas de fuite de trace). Mettre true
# ponctuellement si vous devez voir une erreur détaillée pendant le test.
APP_DEBUG=false

# ⚠️ RÉGÉNÉRER :  docker compose --env-file .env.test-local \
#      -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.test-local.yml \
#      run --rm --no-deps --entrypoint php backend artisan key:generate --show
APP_KEY=

# ⚠️ IP du serveur + schéma http + le port. SANS slash final.
#    Ex. : http://172.30.4.200:8090
APP_URL=http://SERVEUR_IP:8090

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=casa
DB_USERNAME=casa
# ⚠️ IDENTIQUE à POSTGRES_PASSWORD de .env.test-local (racine).
DB_PASSWORD=CHANGE_ME_mot_de_passe_postgres_fort

# --- Session / Sanctum SPA (ADR-01) — RÉGLAGES DE TEST HTTP ---------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# ⚠️ IP EXACTE du serveur, SANS port, SANS schéma.  Ex. : 172.30.4.200
SESSION_DOMAIN=SERVEUR_IP

# ⚠️ IP + PORT (8090 est non-standard → il DOIT figurer). Ex. : 172.30.4.200:8090
SANCTUM_STATEFUL_DOMAINS=SERVEUR_IP:8090

# ⚠️ TEST : false → le cookie de session est posé sur HTTP (sinon login KO).
#    REMETTRE true en prod réelle (§ 14).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# --- Proxies de confiance (bootstrap/app.php) ----------------------------
# En mode test HTTP DIRECT, le navigateur parle directement à nginx : il n'y a
# AUCUN proxy légitime. `docker/nginx/casa.test.conf` REMPLACE X-Forwarded-For
# par l'IP TCP réelle (pas de passthrough) → un client ne peut pas forger son
# IP. On fait juste confiance au réseau Docker de CASA pour que Laravel LISE
# cette IP (sinon `$request->ip()` = IP du conteneur nginx pour tout le monde,
# et le rate-limiting devient un seau unique).
#   Vérif : docker network inspect casa_casa -f '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXIES=172.31.243.0/24

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database
DB_TEST_DATABASE=casa_test

# File d'attente + e-mail (Lot 12a). Le service `worker` tourne aussi en mode
# test (hérité de docker-compose.prod.yml). `log` par défaut : renseigner
# MAIL_HOST/… + MAIL_MAILER=smtp si vous voulez tester un envoi réel.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@casa-arbredevie.ci"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
