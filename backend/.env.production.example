# =============================================================================
#  CASA — Configuration Laravel PRODUCTION.
#
#  Copier en backend/.env.production (GITIGNORÉ) et ajuster :
#    cp backend/.env.production.example backend/.env.production
#
#  Injecté dans le conteneur `backend` par docker-compose.prod.yml (env_file).
#  Aucun `.env` n'est présent dans l'image (.dockerignore) : `env()` résout
#  depuis l'environnement du conteneur.
#
#  ┌───────────────────────────────────────────────────────────────────────────┐
#  │ TABLEAU  variable → dev (localhost) → prod → À CHANGER avant déploiement    │
#  └───────────────────────────────────────────────────────────────────────────┘
#
#   APP_ENV                    local              production          — (fixé ici)
#   APP_DEBUG                   true               false               — (fixé ici)
#   APP_KEY                     <clé dev>          <clé DÉDIÉE>         ⚠️ RÉGÉNÉRER
#   APP_URL                     http://localhost:8080  https://<domaine>   ⚠️ DOMAINE
#   SESSION_DOMAIN              localhost          <host exact>         ⚠️ DOMAINE
#   SANCTUM_STATEFUL_DOMAINS    localhost:8080,…   <host exact>         ⚠️ DOMAINE
#   SESSION_SECURE_COOKIE       (absent → false)   true                — (fixé ici)
#   SESSION_SAME_SITE           lax                lax                 —
#   DB_PASSWORD                 casa               <fort>              ⚠️ = POSTGRES_PASSWORD
#   TRUSTED_PROXIES             (absent)           * (ou sous-réseau)  ⚠️ resserrer conseillé
#   LOG_CHANNEL / LOG_LEVEL     stack / debug      stderr / warning    — (fixé ici)
#   VITE_API_URL               /api               /api                — (relatif, inchangé)
#   MAIL_MAILER                 log                log → smtp          ⚠️ smtp avant prod réelle
#   MAIL_HOST/PORT/USERNAME/…   (vides)            <fournisseur SMTP>  ⚠️ VOS identifiants (§ 9)
# =============================================================================

APP_NAME=CASA
APP_ENV=production
APP_DEBUG=false

# ⚠️ RÉGÉNÉRER une clé DÉDIÉE à la prod (jamais celle du dev) :
#    docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# ⚠️ Domaine public réel, AVEC le schéma https, SANS slash final.
APP_URL=https://casa.example.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logs : vers stderr → `docker compose logs backend` (12-factor) ---------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de données (service `postgres` du compose) -----------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=casa
DB_USERNAME=casa
# ⚠️ IDENTIQUE à POSTGRES_PASSWORD de .env.production (racine). Fort.
DB_PASSWORD=CHANGE_ME_mot_de_passe_postgres_fort

# --- Session / Sanctum SPA (ADR-01) ---------------------------------------
# Cycle CSRF prouvé sain au Lot 9a. En prod, la SEULE différence fonctionnelle
# est le flag `Secure` sur les cookies (session + XSRF-TOKEN).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# ⚠️ DOMAINE — host EXACT servant l'app, SANS port, SANS schéma.
#    Ex. : casa.example.org
#    Apex + www : mettre « .example.org » (point initial) pour partager la session.
SESSION_DOMAIN=casa.example.org

# ⚠️ DOMAINE — host(s) reconnus « frontend » par Sanctum (fromFrontend compare
#    le host du Referer/Origin). Port SEULEMENT si non-standard.
#    Ex. : casa.example.org   —   ou   casa.example.org,*.example.org
SANCTUM_STATEFUL_DOMAINS=casa.example.org

# HTTPS obligatoire : cookies (session + XSRF-TOKEN) uniquement sur TLS.
SESSION_SECURE_COOKIE=true
# `lax` = correct pour une SPA same-origin. NE PAS mettre `strict` (déconnecte
# sur un lien entrant, ex. e-mail) ni `none` (inutile same-origin).
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# --- Proxies de confiance (bootstrap/app.php) -----------------------------
# ⚠️ NE JAMAIS mettre « * ». Derrière Apache (mode § 14), Apache AJOUTE l'IP
#    client à `X-Forwarded-For` sans écraser ce que le client a déjà mis :
#    avec « * » Laravel fait confiance à toute la chaîne → un client qui envoie
#    lui-même `X-Forwarded-For: <IP bidon>` USURPE son IP. Conséquences :
#      - contournement du rate-limiting keyé sur l'IP (`casa-public` 60/min,
#        `login` 5/min, `register` 3/min) → brute-force / spam d'inscriptions ;
#      - logs applicatifs pollués (`AuthController` journalise `$request->ip()`).
#    Risque RÉEL sur un serveur qui héberge d'autres applications.
#
# Valeur = le sous-réseau Docker de CASA, FIXÉ par docker-compose.prod.yml
# (variable CASA_SUBNET, défaut 172.31.243.0/24). Laravel remonte alors la
# chaîne X-Forwarded-For et s'arrête au 1er hop HORS de ce sous-réseau =
# l'IP client réelle (Apache et le nginx de CASA la transmettent correctement).
#
# Vérifier après le premier `up` que le réseau a bien ce sous-réseau :
#   docker network inspect casa_casa -f '{{(index .IPAM.Config 0).Subnet}}'
# Si vous changez CASA_SUBNET (collision d'adresses), répercuter la valeur ICI
# ET dans docker/nginx/casa.apache.conf (directive set_real_ip_from).
TRUSTED_PROXIES=172.31.243.0/24

# --- Limiteurs de débit ajustables (config/casa.php) -------------------------
# Lus UNIQUEMENT via config('casa.rate_limits.*') dans AppServiceProvider,
# jamais env() directement — sinon silencieusement ignorés après config:cache
# (l'entrypoint le relance à chaque `up`/`--force-recreate`, ADR-28).
# Défauts (commentés) déjà calibrés pour des inscriptions/connexions DE GROUPE
# depuis une même IP publique (même Wi-Fi) ; resserrer seulement si un abus
# réel est constaté. casa-api/casa-uploads/casa-candidatures/
# casa-mot-de-passe restent des littéraux dans AppServiceProvider (inchangés,
# déjà cohérents par UTILISATEUR, pas par IP).
#   RATE_LIMIT_REGISTER_PER_MINUTE   40/min/IP  — inscriptions (anti-bot)
#   RATE_LIMIT_REGISTER_PER_DAY      600/j/IP
#   RATE_LIMIT_LOGIN_PER_MINUTE      5/min, clé email+IP — anti-bruteforce PAR COMPTE, NE PAS monter
#   RATE_LIMIT_LOGIN_IP_PER_MINUTE   120/min/IP — plafond PAR IP seule (contre un robot multi-comptes)
#   RATE_LIMIT_PUBLIC_PER_MINUTE     600/min/IP — /api/health, /api/filieres
# RATE_LIMIT_REGISTER_PER_MINUTE=40
# RATE_LIMIT_REGISTER_PER_DAY=600
# RATE_LIMIT_LOGIN_PER_MINUTE=5
# RATE_LIMIT_LOGIN_IP_PER_MINUTE=120
# RATE_LIMIT_PUBLIC_PER_MINUTE=600

# --- Divers -------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# Base de test (non utilisée en prod, laissée pour cohérence d'outillage).
DB_TEST_DATABASE=casa_test

# --- File d'attente (Lot 12a, ADR-31) ---------------------------------------
# Les e-mails partent en ASYNCHRONE : l'action de l'utilisateur n'attend jamais
# le SMTP. Traités par le service `worker` (docker-compose.prod.yml).
QUEUE_CONNECTION=database
# Un job « réservé » mais non terminé au bout de N s est repris (worker tué en
# plein envoi → pas de perte). Garder > MAIL timeout du worker (60 s).
DB_QUEUE_RETRY_AFTER=90

# --- E-mail (Lot 12a, ADR-31) — notifications transactionnelles -------------
# Par défaut « log » : les e-mails sont ÉCRITS DANS LES LOGS, PAS envoyés.
#
# ⚠️ Pour ACTIVER l'envoi réel (obligatoire avant d'ouvrir aux vrais candidats,
#    cf. checklist § 11) : passer MAIL_MAILER=smtp et remplir les lignes
#    ci-dessous avec les identifiants de VOTRE fournisseur SMTP. Ce fichier
#    (backend/.env.production) est GITIGNORÉ et n'entre jamais dans l'image.
#    Après édition : `dcp up -d --force-recreate backend worker`,
#    puis valider : `dcp exec backend php artisan casa:test-email vous@domaine`.
MAIL_MAILER=log

MAIL_HOST=
MAIL_PORT=587
# 587 → STARTTLS : laisser MAIL_SCHEME vide.   465 → TLS implicite : MAIL_SCHEME=smtps
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
# Alternative : une seule variable DSN (certains fournisseurs). Si vous
# l'utilisez, laissez MAIL_HOST/PORT/USERNAME/PASSWORD vides.
#   ex. : smtp://identifiant:motdepasse@smtp.exemple.net:587
MAIL_URL=

# Épinglage de certificat (serveur SMTP à certificat AUTO-SIGNÉ, ex.
# mail.cci.ci) — laisser VIDE pour la vérification standard (comportement
# normal, recommandé dès que le serveur a un certificat signé par une CA
# reconnue). Si renseignée, SEUL le certificat ayant cette empreinte SHA-256
# est accepté (et la vérification de chaîne CA est désactivée pour ce
# mailer UNIQUEMENT — épingler l'empreinte exacte du certificat est une
# garantie au moins aussi forte qu'une CA pour un endpoint connu et unique).
# Format accepté : avec ou sans « : », majuscules ou minuscules — ex. les
# deux écritures suivantes sont équivalentes :
#   E6:6F:EE:C9:0F:FB:97:4E:71:A0:01:DB:8A:21:85:3A:DB:FE:7D:F1:39:ED:F3:42:B2:3B:61:B0:95:67:A6:82
#   e66feec90ffb974e71a001db82185a3dbfe7df139edf342b23b61b09567a682
# Pour obtenir l'empreinte du certificat réellement servi :
#   openssl s_client -connect mail.cci.ci:587 -starttls smtp </dev/null 2>/dev/null \
#     | openssl x509 -fingerprint -sha256 -noout
# Après édition : `dcp up -d --force-recreate backend worker` (cf. §9.6bis
# docs/DEPLOIEMENT.md).
MAIL_PEER_FINGERPRINT=

# Débit MAXIMUM d'envoi des e-mails de notification (Lot 18/18bis,
# ADR-35/36) — le serveur de messagerie peut rejeter (421 « submission
# rate... exceeded ») un envoi trop rapide, ex. lors d'inscriptions en
# rafale ou d'un renvoi groupé d'échecs. CONTRAINTE CONFIRMÉE : le serveur
# impose une limite basse, de l'ordre de 5 à 10 messages/minute, QUI NE
# SERA PAS RELEVÉE — 5/min est le défaut le plus prudent de cette plage.
# Ajustable sans redéploiement de code — juste cette variable + un
# `dcp up -d --force-recreate backend worker`, cf. docs/DEPLOIEMENT.md §9.4.
MAIL_MAX_PER_MINUTE=5

# Coupe-circuit des e-mails de notification INFORMATIFS (Lot 18bis, ADR-36)
# — InscriptionConfirmee, CandidatureSoumise, EntretienPlanifie,
# EntretienReplanifie, ResultatsPublies. Activé par défaut (envoi normal).
# Mettre à `false` pour les couper TEMPORAIREMENT (ex. pendant une
# inscription de masse, afin de réserver le débit SMTP rare aux e-mails
# CRITIQUES) : la notification DANS L'APPLICATION (canal « database »)
# n'est JAMAIS affectée, ni les e-mails critiques
# (ReinitialisationMotDePasse, MotDePasseModifie — sécuritaires, jamais
# coupés par ce réglage). Après édition :
# `dcp up -d --force-recreate backend worker` (cf. docs/DEPLOIEMENT.md §9.4bis).
MAIL_NOTIFICATIONS_INFORMATIVES=true

# Adresse expéditrice — doit être autorisée par le fournisseur (SPF / DKIM).
MAIL_FROM_ADDRESS="no-reply@casa-arbredevie.ci"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
