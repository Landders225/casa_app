APP_NAME=CASA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (PostgreSQL, service "postgres" du docker-compose) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=casa
DB_USERNAME=casa
DB_PASSWORD=casa

# --- Session / Sanctum (mode SPA, cookies same-origin — ADR-01) ---
# SESSION_DOMAIN et SANCTUM_STATEFUL_DOMAINS doivent désigner le domaine public
# unique servi par nginx (ici localhost:8080). À ajuster en staging/production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Base de test PostgreSQL (php artisan casa:test-db ; utilisée par phpunit.xml)
DB_TEST_DATABASE=casa_test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# File d'attente (e-mails asynchrones, Lot 12a). En dev, aucun worker ne tourne
# par défaut : lancer `php artisan queue:work` dans un terminal à part, ou
# `casa:test-email` (envoi synchrone, écrit dans les logs avec MAIL_MAILER=log).
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

# E-mail — `log` en dev : les messages sont écrits dans storage/logs/laravel.log,
# jamais envoyés. Remplir MAIL_HOST/… + MAIL_MAILER=smtp pour un envoi réel.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
# Épinglage de certificat SMTP (serveur à certificat auto-signé) — voir
# backend/.env.production.example pour le détail du format et l'usage.
# Vide en dev = vérification standard inchangée.
MAIL_PEER_FINGERPRINT=
# Débit MAXIMUM d'envoi des e-mails de notification (Lot 18/18bis, ADR-35/36)
# — voir backend/.env.production.example pour le détail. Défaut prudent :
# 5/min (plage confirmée 5-10, ne sera pas relevée).
MAIL_MAX_PER_MINUTE=5
# Coupe-circuit des e-mails INFORMATIFS (pas les critiques) — voir
# backend/.env.production.example pour le détail. Activé par défaut.
MAIL_NOTIFICATIONS_INFORMATIVES=true
MAIL_FROM_ADDRESS="no-reply@casa-arbredevie.ci"
MAIL_FROM_NAME="${APP_NAME}"

# --- Limiteurs de débit ajustables (groupes qui s'inscrivent/se connectent
# depuis une même IP publique, ex. même Wi-Fi) — config/casa.php, jamais lus
# par env() directement dans le code (compatible config:cache). Absents ici =
# les défauts commentés s'appliquent. casa-api/casa-uploads/casa-candidatures/
# casa-mot-de-passe restent des littéraux dans AppServiceProvider (inchangés).
# RATE_LIMIT_REGISTER_PER_MINUTE=40
# RATE_LIMIT_REGISTER_PER_DAY=600
# RATE_LIMIT_LOGIN_PER_MINUTE=5
# RATE_LIMIT_LOGIN_IP_PER_MINUTE=120
# RATE_LIMIT_PUBLIC_PER_MINUTE=600

VITE_APP_NAME="${APP_NAME}"
