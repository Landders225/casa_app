# =============================================================================
#  CASA — Variables de docker-compose PRODUCTION (racine).
#
#  Copier en .env.production (GITIGNORÉ) et ajuster avant déploiement :
#    cp .env.production.example .env.production
#
#  Lancement :
#    docker compose --env-file .env.production \
#      -f docker-compose.yml -f docker-compose.prod.yml up -d
#
#  ⚠️  Ce fichier ne contient QUE les variables interpolées par les fichiers
#      compose. La configuration de Laravel est dans backend/.env.production.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# OBLIGATOIRE en prod (aucune valeur par défaut). Doit être IDENTIQUE à
# DB_PASSWORD de backend/.env.production. Générer : `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_postgres_fort
POSTGRES_DB=casa
POSTGRES_USER=casa

# --- TLS (mode AUTONOME : CASA termine le TLS) ------------------------------
# Utilisé UNIQUEMENT avec docker-compose.prod.yml seul. Répertoire HÔTE
# contenant fullchain.pem + privkey.pem, monté en lecture seule dans le
# conteneur nginx sous /etc/nginx/tls.
#   - bootstrap  : ./docker/nginx/tls  (rempli par docker/nginx/gen-selfsigned.sh)
#   - production  : idem, alimenté par le --deploy-hook de certbot
#                   (docker/nginx/renew-hook.sh copie les fichiers PLATS ici)
TLS_DIR=./docker/nginx/tls

# --- Mode DERRIÈRE UN APACHE EXISTANT (docker-compose.apache.yml) -----------
# CASA n'écoute qu'en HTTP local ; Apache (façade 80/443) termine le TLS et
# proxifie vers ce port. Voir docs/DEPLOIEMENT.md § « Apache existant ».
#   CASA_HTTP_PORT  port local exposé par le nginx de CASA (doit être libre)
#   CASA_BIND_ADDR  interface d'écoute — 127.0.0.1 (Apache sur le même hôte).
#                   0.0.0.0 UNIQUEMENT si Apache est sur une autre machine
#                   (alors : restreindre par pare-feu au hôte Apache).
CASA_HTTP_PORT=8090
CASA_BIND_ADDR=127.0.0.1

# --- Port dev (inutilisé en prod) -----------------------------------------
# APP_PORT=8080
