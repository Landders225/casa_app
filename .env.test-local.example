# =============================================================================
#  CASA — Variables docker-compose, MODE TEST LOCAL HTTP (Lot 11).
#
#  Copier en .env.test-local (GITIGNORÉ) :
#    cp .env.test-local.example .env.test-local
#
#  ⚠️ MODE TEST : accès HTTP direct au port, aucun HTTPS. NE PAS exposer sur
#     Internet. Voir docs/DEPLOIEMENT.md § 13.
# =============================================================================

# --- PostgreSQL : mot de passe fort, IDENTIQUE à DB_PASSWORD de
#     backend/.env.test-local. Générer : openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_postgres_fort
POSTGRES_DB=casa
POSTGRES_USER=casa

# --- Sous-réseau Docker FIGÉ = TRUSTED_PROXIES (backend/.env.test-local).
#     Les deux DOIVENT être identiques (voir § 13 / § 14.5).
CASA_SUBNET=172.31.243.0/24

# --- Écoute HTTP de nginx CASA -------------------------------------------
CASA_HTTP_PORT=8090
# 0.0.0.0 = toutes interfaces → joignable depuis le réseau : http://<IP-serveur>:8090
# (127.0.0.1 ne serait joignable QUE depuis le serveur lui-même).
CASA_BIND_ADDR=0.0.0.0
